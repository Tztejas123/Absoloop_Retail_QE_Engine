<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Suite" thread-count="2" parallel="tests">
    
    <listeners>
        <listener class-name="com.absolooplab.Utility.ExtentReportManager" />
    </listeners>

    <test name="ChromeTest">
        <parameter name="os" value="Windows" />
        <parameter name="browser" value="chrome" />
        <parameter name="url" value="https://tutorialsninja.com/demo/" />
        <classes>
            <class name="com.absoloop.testCases.TC_001_AccountRegistrationTest"/>
            <class name="com.absoloop.testCases.TC_002_LoginTest"/>
            <class name="com.absoloop.testCases.TC_003_LoginDDT"/>
        </classes>
    </test>

    <test name="FireFoxTest">
        <parameter name="os" value="Windows" />
        <parameter name="browser" value="firefox" />
        <parameter name="url" value="https://tutorialsninja.com/demo/" />
        <classes>
           <class name="com.absoloop.testCases.TC_001_AccountRegistrationTest"/>
            <class name="com.absoloop.testCases.TC_002_LoginTest"/>
            <class name="com.absoloop.testCases.TC_003_LoginDDT"/>
        </classes>
    </test>

</suite>