<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="RegressionSuite" parallel="classes" thread-count="3">

    <listeners>
        <listener class-name="com.absolooplab.Utility.ExtentReportManager"/>
    </listeners>

    <test name="Headless_Regression">
        <parameter name="browser" value="chrome"/>
        <parameter name="execution" value="local"/>
        <parameter name="headless" value="true"/>

        <classes>
            <class name="com.absoloop.testCases.TC_001_AccountRegistrationTest"/>
            <class name="com.absoloop.testCases.TC_002_LoginTest"/>
            <class name="com.absoloop.testCases.TC_003_LoginDDT"/>
        </classes>
    </test>

</suite>