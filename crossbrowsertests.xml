<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSuite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="com.absolooplab.Utility.ExtentReportManager"/>
    </listeners>

    <test name="Chrome_Test">
        <parameter name="browser" value="chrome"/>
        <parameter name="execution" value="local"/>
        <parameter name="headless" value="false"/>

        <classes>
            <class name="com.absoloop.testCases.TC_001_AccountRegistrationTest"/>
        </classes>
    </test>

    <test name="Edge_Test">
        <parameter name="browser" value="edge"/>
        <parameter name="execution" value="local"/>
        <parameter name="headless" value="false"/>

        <classes>
            <class name="com.absoloop.testCases.TC_001_AccountRegistrationTest"/>
        </classes>
    </test>

</suite>